# Pages must never be served from an old copy: browsers and Cloudflare's edge check for a new version on every
# request (the ETag makes that cheap). Cloudflare-CDN-Cache-Control applies to Cloudflare's cache only, so a
# "Cache Everything" rule can't pin an old homepage either.
/
  Cache-Control: no-cache
  Cloudflare-CDN-Cache-Control: no-store
/use-cases/*
  Cache-Control: no-cache
  Cloudflare-CDN-Cache-Control: no-store
/robots.txt
  Cache-Control: no-cache
/sitemap.xml
  Cache-Control: no-cache
/llms.txt
  Cache-Control: no-cache

# Built JS and CSS have a content hash in their names, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
