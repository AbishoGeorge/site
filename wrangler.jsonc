{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "compatibility_date": "2026-10-01",
  // Handles POST /api/contact (emails form submissions through Resend). Everything else is the static site.
  "main": "worker/index.ts",
  "assets": {
    // `npm run build` writes every public page to dist as finished HTML (/, /use-cases/<id>/), plus robots.txt,
    // sitemap.xml and llms.txt. Panels inside the page open from the URL hash, so no index.html fallback is needed.
    "directory": "./dist",
    "binding": "ASSETS",
    // "/" is dist/index.html, "/use-cases/x/" is dist/use-cases/x/index.html. Unknown paths get a plain 404: there is
    // no single-page-app fallback, so no address can be answered by a stale or empty app shell.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Only API requests reach the Worker; pages and files are served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // CONTACT_TO_EMAIL and CONTACT_FROM_EMAIL are set in the Cloudflare dashboard, and RESEND_API_KEY is a secret.
  // keep_vars stops each deploy from wiping the dashboard variables.
  "keep_vars": true,
  "observability": { "enabled": true }
}
